<!-- add academicons and font awesome -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons/css/academicons.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<!-- add MathJax -->
<script>
  window.MathJax = {
    tex: {
      inlineMath: [['$', '$'], ['\\(', '\\)']],
      displayMath: [['$$', '$$'], ['\\[', '\\]']]
    },
    svg: {
      fontCache: 'global'
    }
  };
</script>
<script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>

<!-- CSS styling -->
<style>
  .blogs-container {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-top: 1.5rem;
  }

  .blog-item {
    display: flex;
    background-color: body-mix(16%);
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.2s ease;
    animation: fadeIn 0.6s ease forwards;
    opacity: 0;
    border: 1px solid body-mix(50%);
  }

  .blog-item:nth-child(1)  { animation-delay: 0.05s; }
  .blog-item:nth-child(2)  { animation-delay: 0.1s;  }
  .blog-item:nth-child(3)  { animation-delay: 0.15s; }
  .blog-item:nth-child(4)  { animation-delay: 0.2s;  }
  .blog-item:nth-child(5)  { animation-delay: 0.25s; }
  .blog-item:nth-child(6)  { animation-delay: 0.3s;  }
  .blog-item:nth-child(7)  { animation-delay: 0.35s; }
  .blog-item:nth-child(8)  { animation-delay: 0.4s;  }
  .blog-item:nth-child(9)  { animation-delay: 0.45s; }
  .blog-item:nth-child(10) { animation-delay: 0.5s;  }
  .blog-item:nth-child(11) { animation-delay: 0.55s; }
  .blog-item:nth-child(12) { animation-delay: 0.6s;  }

  .blog-image {
    width: 280px;
    height: 158px;
    object-fit: cover;
    flex-shrink: 0;
    border-radius: 7px;
  }

  .blog-info {
    padding: 1.2rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .blog-title {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: #ffffff;
    position: relative;
    letter-spacing: 0.01em;
    font-family: 'Latin Modern Math', 'STIX Two Math', 'STIX Two', 'Computer Modern', 'Times New Roman', serif;
    text-decoration: none;
  }

  .blog-title:hover {
    text-decoration: underline;
  }

  /* MathJax specific styling to ensure consistency between title and LaTeX math */
  .paper-title .MJX-TEX {
    font-size: inherit !important;
    color: inherit !important;
  }

  /* hide any anchor symbols */
  .anchor-section {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  .blog-meta {
    font-size: 0.9rem;
    opacity: 0.85;
    margin-bottom: 0.8rem;
    color: body-mix(67%);
  }

  .blog-description {
    font-size: 1rem;
    line-height: 1.5;
    color: body-mix(80%);
  }

  @media (max-width: 768px) {
    .blog-item {
      flex-direction: column;
    }

    .blog-image {
      width: 100%;
      height: auto;
      aspect-ratio: 16/9;
      border-radius: 7px; /* rounded corners */
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

```{=html}
<div class="blogs-container">
  <% for (const blog of items) { %>
    <div class="blog-item">
      <a href="<%= blog.path %>">
        <img src="<%= blog.image %>" alt="<%= blog.title %>" class="blog-image">
      </a>
      <div class="blog-info">
        <a href="<%= blog.path %>" class="blog-title"><%- blog.title %></a>
        <div class="blog-meta"><%- blog.date %></div>
        <div class="blog-description"><%- blog.description %></div>
      </div>
    </div>
  <% } %>
</div>
```
